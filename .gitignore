node_modules
# out/ is the scratch directory every author tool writes to (renders, mixes, logs, sound-vary specs,
# the gallery build): every file in it is regenerable, none is source. `out/**/*.<ext>` rules used to
# list this out file-extension by file-extension and still missed `.m4a` (12 files reached main that
# way); ignoring the whole tree by pattern is the fix that can't be outrun by a new extension.
# `!out/.gitkeep` keeps the directory present in a fresh clone.
out/
!out/.gitkeep
.vawe/
assets/*.mp3
# no font binary ships from this repo, paid or not (NOTICE): woff2 already covered above,
# a bare .woff (e.g. a paid Klim face used locally for fidelity) is the same rule, same directory.
assets/fonts/*.woff2
assets/fonts/*.woff
.DS_Store

# bin/vawe is the tracked CLI; anything else in bin/ is a local build
bin/*
!bin/vawe
!bin/vawe-dev

# verify + previews (generated output). out/ itself is covered wholesale above; these two live
# outside out/.
quality/runs/out/
verify/*_contactsheet.png
quality/runs/frames/
# gate-mutation's exclusive lock: it edits tracked source in place, so two runs must not overlap.
# Removed on exit; a leftover one means a run was killed: check `git status` before trusting the tree.
quality/fixtures/.gate-mutation.lock

# transient DOM/layer-JSON snapshot baselines (make snap, make snap-blocks)
quality/baselines/snap/*
# …except the digest: one sha256 per scene (under `scenes`) and per block (under `blocks`) plus the
# font state, ~10-15KB. It is what lets a fresh clone and CI answer "did this move" for both nets when
# the tens of MB of full signatures beside it cannot be committed.
!quality/baselines/snap/digest.json

# review receipts: proof a beats/reveal sheet was rendered for a given scene content hash
# (make beats / make reveal write them, quality/gates/beat-check.mjs reads them). Local, per-machine.
quality/runs/beats-seen/
quality/baselines/approved/

# make evals: every timestamped run + compare dir is scratch, mp4s included. quality/runs/evals/baseline/ is
# the one committed run, and only its sheets + manifest.json, never its mp4s (they are gigabytes across
# a library; see guides/EVALS.md and harness/dev/evals.mjs saveBaseline()).
quality/runs/evals/runs/
quality/runs/evals/baseline/*.mp4

# make e2e: every timestamped run + latest.json is scratch, regenerated on the next run. The committed
# reference the suite compares against is quality/baselines/snap/digest.json and
# quality/baselines/e2e-known-broken.json, both tracked, neither under quality/runs/.
quality/runs/e2e/

# kie.ai secret + generated assets
.kie.key
assets/gen
# baked simulation frames: 480+ PNGs, ~67MB, regenerated by `make sim`. Provenance lives in
# meta.json and `make check GATE=sim-audit` fails if a bake is stale, so the frames themselves are build output.
assets/baked/
quality/ledger/
assets/brands/**
!assets/brands/
!assets/brands/*/
!assets/brands/*/house-style.md
# paid/licensed fonts: used locally for fidelity, never committed (redistribution)
assets/fonts/local/

# vendored skill with no declared license, kept local, not redistributed (see NOTICE)
skills/taste-skill/


# Video/data instances are NOT the framework (framework = scene.html + schema.json + sample.json).
# Keep the engine + schema + reference sample tracked; ignore the authored videos.
films/scene/*.json
!films/scene/sample.json
!films/scene/schema.json
# ...but the repo's OWN demos are framework presentation, not content: the README film and the
# showcase clips are what the project ships to explain itself, and an untracked source means a
# clean clone cannot rebuild them (the same "not reproducible from the repo" bug class as a scene
# whose aspect lived in shell history). Brand films (argus/stripe/linear) stay untracked: those
# are content.
!films/scene/vawe-intro.json
!films/scene/hero-site.json
!films/scene/showcase-*.json
# ...but NOT their expansions. `make expand` writes <name>.expanded.json beside the source, and that is
# build output: scripts/site/scenes-json.mjs treats it as regenerable and says so. The showcase
# allowlist above is a glob, so it was quietly re-including the generated file too.
films/scene/*.expanded.json
!films/scene/site-backdrop.json
!films/scene/preface-launch.json
!films/scene/preface-launch.*
# gh-wrapped is a TEMPLATE, not a video: it carries {{placeholders}} and renders nothing on its own.
# harness/media/gh-wrapped.mjs is tracked, and an untracked template would leave a clean clone holding
# a generator with no consumer, which is the "not reproducible from the repo" case this section exists
# to prevent. The RENDERED instance (films/scene/_batch/) stays ignored, because that is content.
!films/scene/gh-wrapped.template.json
# The camera-blur A/B. Not a film: it is the fixture the effects
# catalogue both cite, a whip pan across two depth planes plus one layer that counter-pans, so
# the smear and the cancellation can be re-rendered rather than taken on trust. An untracked
# fixture leaves both references naming a file a clean clone does not have.
!films/scene/_camera-blur-probe.json
# ...but its DATA is one account's stats at one moment: regenerable from the API, stale the next day,
# and somebody's record rather than the framework. Same policy as assets/gen.
films/scene/_data/
films/scene/_batch/
# auto-orient: the A/B pair for AE technique 12 (guides/AE-TECHNIQUES.md). Two files that differ
# in one key, the `upright` modifier on each carried mark, so the verdict can be re-rendered rather
# than taken on trust. A worked example the docs NAME and a clone does not have is not an example.
!films/scene/_auto-orient.json
!films/scene/_auto-orient-plain.json
# motion-test: the before/after snap demo: a permanent engine demo AND a motion regression fixture.
!films/scene/motion-test.json
# flagship examples + their registry: the showcase the repo ships (make gallery).
!films/scene/example-*.json
!films/scene/examples.json
# ...but NOT their expansions, same bug as the showcase-* glob above: this allow is a glob too, so it
# was quietly re-including example-*.expanded.json, the compiled twin nobody should learn from.
films/scene/example-*.expanded.json
# TEMPLATES. These are the framework's answer to "how is a launch film shaped": the composition,
# timing, camera and beat structure of a real film with every borrowed identity removed. The product
# is fictional, every colour is a theme token, the marks are inline svg. They ship on purpose. Their
# `.expanded.json` siblings do NOT: those are generated by `make expand`, like any build output.
!films/scene/saas-hero-launch.json
!films/scene/product-feature-tour.json
# process: the third goldSet full-film exemplar (examples.json), an idea proven by one measured
# instance. Its intent + storyboard sidecars ship with it, same rule as the templates above.
!films/scene/process.json
!films/scene/process.intent.json
!films/scene/process.storyboard.md
# Worked examples guides docs and skills name and walk a reader through. A worked
# example a clone does not have is not an example, same rule as _auto-orient above.
!films/scene/_kinetic-cut.json
!films/scene/_kinetic-cut-plain.json
!films/scene/zerochrome.json
!films/scene/brew-native.json
!films/scene/aspects-demo.json
!films/scene/app-showcase.json
!films/scene/playhead.json
!films/scene/_playhead-subject.json
# Music beds are third-party tracks and the Mixkit licence forbids redistributing the files, so the
# audio never lands in git. credits.json is not audio, it is the PROVENANCE, and ignoring the whole
# directory meant the one file that records where a bed came from could not survive a clone: while
# SOUND.md told authors to record provenance there. Same policy as assets/sfx/ above.
assets/music/*
!assets/music/credits.json
# music.wav is BAKED by `make audio` (core/audio-kit.mjs): generated, never committed.
assets/music.wav

# Generated by `node generators/media/audio-bake.mjs`; the mixer builds its cues in memory and never reads them.
assets/sfx/
# One film's captures and renders, local to the machine that made them.
assets/vawe-flow-2/
# Third-party brand marks (trademarks): local only. Own marks and Lucide (ISC) icons stay tracked.
assets/icons/*
!assets/icons/ui/
!assets/icons/markdown*.svg
!assets/icons/vawe-mark.svg
!assets/icons/ledgerline-mark.svg
assets/icons/ui/brew-logo.svg
assets/icons/ui/cursor.svg

# The site's generated fonts (fetched by generators/media/fonts.mjs), copied in by scripts/site/vendor-assets.mjs.
site/public/assets/fonts/

# local scratch (agent shell logs): never commit
/scratchpad/


# Raw cut-out letter SOURCES: 850MB of 1-3MB PNGs, re-extractable from the pack zip at any time.
# The BAKED sprite set (assets/ransom, 21MB) is local-only now (Resource Boy, no-redistribute): re-bake with `make ransom-sprites`.
assets/ransom-src/*
!assets/ransom-src/README.md

# MCP server working data (records, scenes, drafts, exports)
.vawe-data

# the baked draft watermark sheet (make watermark)
assets/watermark/

# generated per-render derivatives (regenerate with make beatsync / make examples)
films/scene/*.beatsync.json
build/
# generated from taste/rules but committed: a test compares it with a fresh build
!taste/build/

# reference films: third-party marketing videos downloaded for LOCAL STUDY ONLY (measure timings,
# easing, beat structure). Never committed, never shipped, never reproduced pixel-for-pixel: a
# recreation reproduces INTENT with our own assets (guides/REFERENCE-STUDY.md).
# Root-anchored: quality/refs/ (quality/refs/LOOP.md) is a different, tracked directory and gets its
# own narrower rule below, not this one.
/refs/
# grammar/ is NOT ignored, and the pair is the point. `refs/` holds other people's films; `grammar/`
# holds what we measured and concluded about them: shot lengths, luma, motion, one accent hex, and the
# sentences a person wrote about what causes what. No frame, no crop, no copy, no mark. The pixels stay
# out of the repo and the reading stops dying with the checkout.
.venv-tools/
assets/cutouts/

# agent worktrees (harness/dev/worktree.sh)
.claude/worktrees/

# quality/refs/<name>/ (quality/refs/LOOP.md): the reference video and every generated artifact under
# a reference's own directory are local-only, reproduced from source.url or the fixture recipe. Only
# beats.md, source.url, queue.md and ledger.jsonl (the record of what was measured) are tracked.
quality/refs/*/source.mp4
quality/refs/*/study/
quality/refs/*/drafts/
quality/refs/*/grid/

# npm pack output: a build artifact, never committed
*.tgz

# ── THIRD-PARTY BRAND RECREATIONS MUST NOT REACH THE PUBLIC REPO ────────────────────────────────
# `films/scene/*.json` above keeps the AUTHORED brand films untracked. It never covered their
# OUTPUTS or the site's own COPIES, and both were tracked: a rendered mp4 of stripe.com carries
# Stripe's headline, gradient and body copy verbatim, and site/public/scenes/ held the sources at a
# path no rule above matches.
#
# Reference films downloaded for study (refs/ above) plus any stray render at the repo root.
/*.mp4

# The site ships no rendered films beyond the moves in site/public/moves and the share loops in site/public/og.
site/public/assets/films/

# Brand-recreation themes: a palette is not a protected work, but a theme that recreates a real
# company's look is a statement this repo does not need to publish. A theme declares itself as one
# by writing `"note": "... reflecting <their site> ..."` (see harness/dev/preset-sheets.mjs and
# scripts/brand/*.mjs, which write themes this way); a human or agent adding a new brand-reflection
# theme must follow that convention so reviewers can find it by grepping `note` for "reflecting".
# `themes/presets/` is the one place this IS enforceable by path: every file there is a named
# reference-profile taste anchor (taste/craft/selection.md), so the whole directory is ignored.
# Direct site recreations load by bare name (`themes/<name>.json`, see core/engine/boot.js /
# harness/author/treatment.mjs), so they cannot move under a subdirectory without a loader change;
# they stay listed here until one exists. They stay on disk so local brand work keeps rendering; they
# are not redistributed. The generic themes the templates use (default, northwind, neutral) are
# tracked and are what a fork should copy.
themes/presets/*.json
themes/stripe.json
themes/linear.json
themes/higgsfield.json

# Scratch experiment themes: one-off A/B variants (`ab*.json`) and per-person tryouts (`hi-<name>.json`)
# made for a single test render, never a shipped look. Pattern, not a filename list, so the next
# ab-run or hi-<name> experiment is ignored without a new line here.
themes/ab*.json
themes/hi-*.json

# scratch probe renders, written by hand during debugging and never an input to anything
assets/video/

# machine-specific Claude Code settings (never share)
.claude/settings.local.json

# Claude Code local config (agent-specific, not shipped): settings, plans, workflows
.claude/

# impeccable live-server local scratch
.impeccable/

# Uncredited capture assets, local-only (not shipped)
assets/rec1/
assets/rec3/

# Resource Boy gradient pack: no-redistribute licence, replaced by the gradient preset. Local-only.
assets/gradients/

# Ransom feature is local-only (Resource Boy licence): its demo scene html and sprites are not shipped
films/scene/_ransom-intro-page.html
assets/ransom/

!films/scene/post-*.json
!films/scene/post-*.storyboard.md
!films/scene/post-*.html
!films/scene/post-*.kit.css

# scratch probes and one-off content pieces nothing else references: untracked, no allowlist earns
# a public spot. The JSON already falls under films/scene/*.json above; these are their sidecars.
films/scene/_glass-shapes.*.html
films/scene/_glass-shapes.storyboard.md
films/scene/process.storyboard.md

# GENERATED MEDIA IS NOT SOURCE. mp3/wav/mp4/m4a files under out/ were tracked at various points,
# every one the output of a command in this repo; out/ is ignored wholesale above now, so nothing
# further is needed here. site/public/assets stays tracked: the marketing site SERVES those, so they
# are content.

# Per-brand demo imagery, the same rule assets/brands/** already applies, for two directories that
# predate it and escaped it. 4MB of one brand's hero art. The only scenes referencing them are
# untracked, so nothing tracked breaks.
assets/plinth/
assets/higgsfield/

# Footage for a local edit: third-party clips (public domain or licensed) that we use but never redistribute.
assets/edit-montage/

/.git-scene-check-base/

# recreations of the owner's in-house references (their text, audio and look): private, never committed
films/recreations/
# draft key-frame sheets that bin/vawe moves leaves next to each clip
prompts/moves/*.png
# the master clips: bin/vawe moves renders them, site/public/moves holds the web encode
prompts/moves/*.mp4
# render-page keeps a failed render's frames next to the output so a resume finds them; never source
*.mp4.frames-*/
# the page bin/vawe moves renders a theme variant from, deleted after the render
prompts/moves/demo/*.variant.html
# Stock footage under the Mixkit licence: used in the rendered clip, never redistributed as a file. credits.json keeps the provenance.
prompts/moves/demo/assets/mask-rise/*.source.mp4

# discovery run output; only a baseline-<date> pair is kept
scripts/discovery/runs/*
!scripts/discovery/runs/baseline-*

# written by `vawe frame --world all` next to each page
films/*/frames.html
films/*/*/frames.html
