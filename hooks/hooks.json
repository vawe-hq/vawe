{
  "description": "Block hand-made writes to films/ and raw ffmpeg or Chrome calls; name the vawe tool to use",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/harness/live/film-guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
