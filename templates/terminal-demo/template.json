{
  "id": "terminal-demo",
  "title": "Terminal demo",
  "summary": "A CLI demo: a command is typed, output streams, a result lands, and the tool name and install line close it.",
  "category": "product",
  "tier": "free",
  "length": 12,
  "aspect": "16:9",
  "structure": "command types with a block caret, steps print as whole rows, a full-width LIVE band lands, the caret flies to the install line, name and install command close",
  "inputs": [
    {
      "key": "folder",
      "label": "Folder in the prompt",
      "default": "~/acme/api",
      "where": ".dir in #cmdrow and #row2, world run"
    },
    {
      "key": "branch",
      "label": "Branch in the prompt",
      "default": " main",
      "where": ".br in #cmdrow and #row2, world run"
    },
    {
      "key": "command",
      "label": "Command that is typed",
      "default": "halcyon deploy --env production",
      "where": "#cmd in world run"
    },
    {
      "key": "version",
      "label": "Tool name and version",
      "default": "halcyon 2.4",
      "where": ".strong in #head, world run"
    },
    {
      "key": "headline",
      "label": "Header line",
      "default": " · deploying api to production",
      "where": ".out in #head, world run"
    },
    {
      "key": "step1",
      "label": "Step 1 running",
      "default": "Building image",
      "where": "#s1 .r, world run"
    },
    {
      "key": "step1done",
      "label": "Step 1 done",
      "default": "Built image",
      "where": "#s1 .d, world run"
    },
    {
      "key": "step1time",
      "label": "Step 1 time",
      "default": "1.8s",
      "where": "#s1 .tm, world run"
    },
    {
      "key": "step2",
      "label": "Step 2 running",
      "default": "Pushing 3 layers",
      "where": "#s2 .r, world run"
    },
    {
      "key": "step2done",
      "label": "Step 2 done",
      "default": "Pushed 3 layers",
      "where": "#s2 .d, world run"
    },
    {
      "key": "step2time",
      "label": "Step 2 time",
      "default": "0.9s",
      "where": "#s2 .tm, world run"
    },
    {
      "key": "layer1",
      "label": "Layer row 1",
      "default": "  a3f9c21  12.4 MB",
      "where": "#l1, world run"
    },
    {
      "key": "layer2",
      "label": "Layer row 2",
      "default": "  b81d07e   3.1 MB",
      "where": "#l2, world run"
    },
    {
      "key": "layer3",
      "label": "Layer row 3",
      "default": "  c40e5a9   0.8 MB",
      "where": "#l3, world run"
    },
    {
      "key": "step3",
      "label": "Step 3 running",
      "default": "Running migrations",
      "where": "#s3 .r, world run"
    },
    {
      "key": "step3done",
      "label": "Step 3 done",
      "default": "Ran 2 migrations",
      "where": "#s3 .d, world run"
    },
    {
      "key": "step3time",
      "label": "Step 3 time",
      "default": "0.4s",
      "where": "#s3 .tm, world run"
    },
    {
      "key": "warning",
      "label": "Warning row",
      "default": "! DEBUG_SQL was on: turned off for production",
      "where": "#warn, world run"
    },
    {
      "key": "step4",
      "label": "Step 4 running",
      "default": "Rolling out",
      "where": "#s4 .r, world run"
    },
    {
      "key": "step4done",
      "label": "Step 4 done",
      "default": "Rolled out 4 of 4 instances",
      "where": "#s4 .d, world run"
    },
    {
      "key": "step4time",
      "label": "Step 4 time",
      "default": "1.5s",
      "where": "#s4 .tm, world run"
    },
    {
      "key": "step5",
      "label": "Step 5 running",
      "default": "Checking health",
      "where": "#s5 .r, world run"
    },
    {
      "key": "step5done",
      "label": "Step 5 done",
      "default": "Health checks passed",
      "where": "#s5 .d, world run"
    },
    {
      "key": "step5time",
      "label": "Step 5 time",
      "default": "1.1s",
      "where": "#s5 .tm, world run"
    },
    {
      "key": "badge",
      "label": "Result badge",
      "default": "LIVE",
      "where": "#res1 first span, world run"
    },
    {
      "key": "result",
      "label": "Result line",
      "default": "api deployed in 5.7s",
      "where": "#res1 second span, world run"
    },
    {
      "key": "url",
      "label": "Link",
      "default": "https://api.acme.dev",
      "where": ".url in #res2, world run"
    },
    {
      "key": "hint",
      "label": "Hint under the link",
      "default": "undo any time with halcyon rollback",
      "where": "#res3, world run"
    },
    {
      "key": "title",
      "label": "Window title",
      "default": "acme/api: halcyon",
      "where": ".ttl, world run"
    },
    {
      "key": "name",
      "label": "Tool name",
      "default": "halcyon",
      "where": "h1.mark before the full stop, world close"
    },
    {
      "key": "tagline",
      "label": "Tagline",
      "default": "Ship from the terminal.",
      "where": "#tag, world close"
    },
    {
      "key": "install",
      "label": "Install command",
      "default": "npm i -g halcyon",
      "where": "#inst, world close"
    },
    {
      "key": "installout",
      "label": "Install output",
      "default": "added 1 package in 2s",
      "where": "#ins2, world close"
    },
    {
      "key": "nextstep",
      "label": "Next step line",
      "default": "run halcyon init to begin",
      "where": "#ins3, world close"
    }
  ],
  "tags": [
    "terminal",
    "cli",
    "developer tool",
    "typing"
  ]
}
